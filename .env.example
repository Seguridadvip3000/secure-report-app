# Modo de almacenamiento: 'supabase' o 'local'
# 'supabase' = usa Supabase (base de datos en la nube)
# 'local' = usa localStorage (solo navegador)
VITE_STORAGE_MODE=supabase

# ============================================
# CONFIGURACIÓN DE SUPABASE
# ============================================
# Solo necesario si VITE_STORAGE_MODE=supabase
# Obtén estos valores en: Settings > API de tu proyecto Supabase

VITE_SUPABASE_URL=https://sjwyqpvnkrmfvfxuhkqp.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_nvZmcx4n-eui2Fg66gVUwA_WDYiicCQ

# ============================================
# CONFIGURACIÓN DE EMAILJS (OPCIONAL)
# ============================================
# Para enviar emails reales a los clientes cuando se aprueban reportes
# Si no se configura, los emails se simularán en la consola
#
# Pasos para configurar:
# 1. Crear cuenta en https://www.emailjs.com/
# 2. Crear un "Email Service" (Gmail, Outlook, etc.)
# 3. Crear un "Email Template" con las variables:
#    - to_email, to_name, report_title, report_project, 
#    - report_date, report_description, report_url
# 4. Copiar las credenciales abajo

VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

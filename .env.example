# Modo de almacenamiento: 'supabase' o 'local'
# 'supabase' = usa Supabase (base de datos en la nube)
# 'local' = usa localStorage (solo navegador)
VITE_STORAGE_MODE=local

# ============================================
# CONFIGURACIÓN DE SUPABASE
# ============================================
# Solo necesario si VITE_STORAGE_MODE=supabase
# Obtén estos valores en: Settings > API de tu proyecto Supabase

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

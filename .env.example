# Modo de almacenamiento: 'supabase' o 'local'
# 'supabase' = usa Supabase (base de datos en la nube)
# 'local' = usa localStorage (solo navegador)
VITE_STORAGE_MODE=supabase

# ============================================
# CONFIGURACIÓN DE SUPABASE
# ============================================
# Solo necesario si VITE_STORAGE_MODE=supabase
# Obtén estos valores en: Settings > API de tu proyecto Supabase

VITE_SUPABASE_URL=https://sjwyqpvnkrmfvfxuhkqp.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_nvZmcx4n-eui2Fg66gVUwA_WDYiicCQ

# ============================================
# CONFIGURACIÓN DE EMAILJS (OPCIONAL)
# ============================================
# Sistema de 3 notificaciones automatizadas:
# 1. Alerta de Registro Pendiente → Directiva
# 2. Alerta de Reporte Creado → Operaciones y Directiva
# 3. Alerta de Reporte Aprobado → Cliente + Directiva (CC)
#
# Pasos para configurar:
# 1. Crear cuenta en https://www.emailjs.com/
# 2. Crear un "Email Service" (Gmail, Outlook, etc.)
# 3. Crear 3 templates en EmailJS:
#
#    Template 1: template_new_user_registration
#    Variables: {{to_email}}, {{to_name}}, {{username}}, {{nombre_completo}}, {{user_email}}, {{user_role}}
#
#    Template 2: template_new_report_created
#    Variables: {{to_email}}, {{to_name}}, {{report_title}}, {{report_project}}, {{report_description}}, {{supervisor_name}}
#
#    Template 3: template_report_approved
#    Variables: {{to_email}}, {{to_name}}, {{report_title}}, {{report_project}}, {{report_date}}, {{report_description}}, {{report_url}}
#
# 4. Copiar las credenciales abajo

VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Templates adicionales para las 3 notificaciones
VITE_TEMPLATE_NEW_USER_REGISTRATION=template_new_user_registration
VITE_TEMPLATE_NEW_REPORT_CREATED=template_new_report_created
VITE_TEMPLATE_REPORT_APPROVED=template_report_approved

# Emails de destinatarios (configurar según tu organización)
VITE_DIRECTIVA_EMAIL=directiva@seguridad.com
VITE_OPERACIONES_EMAIL=operaciones@seguridad.com
